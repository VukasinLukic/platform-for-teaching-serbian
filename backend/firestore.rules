rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = custom claim `role: admin`. Claims can only be set with the Admin SDK
    // (setUserRole / scripts/setAdminClaim.js), never by the user. The `role` field in
    // the users document is display-only and must never be trusted here.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('role', '') == 'admin';
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection - personal data, readable only by the owner and admins
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.get('role', 'korisnik') == 'korisnik'
                    && request.resource.data.get('emailVerified', false) == false
                    && !request.resource.data.keys().hasAny(['verifiedAt', 'roleUpdatedAt']);
      // Owners may edit their profile but never their role or verification status
      allow update: if isAdmin() ||
                    (isAuthenticated() && request.auth.uid == userId &&
                     !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['role', 'roleUpdatedAt', 'emailVerified', 'verifiedAt']));
      allow delete: if isAdmin();
    }

    // Courses collection - everyone can read active courses
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Modules collection - everyone can read (for course info)
    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lessons collection - everyone can read (for course info and lesson count)
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Transactions collection
    // Created only on the server (createCourseTransaction / generateInvoice) so the
    // amount and course come from the database. The buyer may only attach a payment
    // confirmation to their own pending transaction.
    function isTransactionOwner() {
      return isAuthenticated() &&
             (resource.data.user_id == request.auth.uid ||
              resource.data.userId == request.auth.uid);
    }

    match /transactions/{transactionId} {
      allow read: if isTransactionOwner() || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                    (isTransactionOwner() &&
                     resource.data.status == 'pending' &&
                     request.resource.data.status == 'pending' &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['confirmationUrl', 'confirmationUploadedAt', 'status']));
      allow delete: if isAdmin();
    }

    // User courses collection
    match /user_courses/{userId} {
      // ✅ Require email verification for course access
      allow read: if (request.auth.uid == userId && request.auth.token.email_verified == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Files collection
    match /files/{fileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Progress tracking
    match /progress/{progressId} {
      allow read: if isAuthenticated() &&
                     progressId.matches(request.auth.uid + '_.*');
      allow write: if isAuthenticated() &&
                      progressId.matches(request.auth.uid + '_.*');
    }

    // Online packages - read for all, write for admin only
    match /online_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Online enrollments - user can read own, admin can read/write all
    match /online_enrollments/{enrollmentId} {
      allow read: if isAuthenticated() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      // Enrollments are created by the admin when a payment is approved
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Online groups and sessions (Meet links) - admin only. Enrolled students get
    // their own group's schedule through the getMyOnlineGroup function.
    match /online_groups/{groupId} {
      allow read, write: if isAdmin();
    }

    match /online_sessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      // Allow everyone to read promotions settings
      allow read: if settingId == 'promotions' || isAdmin();
      allow write: if isAdmin();
    }

    // Email verifications collection - backend only
    match /email_verifications/{token} {
      allow read: if false;
      allow write: if false;
    }

    // Rate limits collection - backend only
    match /rate_limits/{limitId} {
      allow read: if false;
      allow write: if false;
    }

    // Assistant (Alano) conversation logs - backend only (written via Admin SDK)
    match /assistant_logs/{logId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
