rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin = custom claim `role: admin` (set only via the Admin SDK).
    // The `role` field in the users document is not trusted.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('role', '') == 'admin';
    }

    // True if the signed-in user owns the given transaction
    function ownsTransaction(transactionId) {
      let tx = firestore.get(/databases/(default)/documents/transactions/$(transactionId)).data;
      return request.auth != null &&
             (tx.get('userId', '') == request.auth.uid || tx.get('user_id', '') == request.auth.uid);
    }

    // Invoices - served through signed URLs from generateInvoice; direct access for admins only
    match /invoices/{fileName} {
      allow read: if isAdmin();
      allow write: if false; // Only cloud functions can write
    }

    // Payment confirmations - only the transaction owner uploads, owner and admin read
    match /payment-confirmations/{transactionId} {
      allow read: if isAdmin() || ownsTransaction(transactionId);
      allow write: if ownsTransaction(transactionId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)|application/pdf');
    }

    // Videos - only admin can upload, users can read through signed URLs
    match /videos/{allPaths=**} {
      allow read: if false; // Use signed URLs only
      allow write: if isAdmin();
    }

    // Course files - authenticated users can read
    match /course-files/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Thumbnails - everyone can read
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course materials - served only through getMaterialUrl (access-checked signed URLs)
    match /course-materials/{courseId}/{lessonId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
